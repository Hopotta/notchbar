<Window x:Class="NotchBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NotchBar.UI"
        Width="424"
        Height="37"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        MouseEnter="Window_OnMouseEnter"
        MouseLeave="Window_OnMouseLeave"
        SourceInitialized="Window_OnSourceInitialized"
        Closed="Window_OnClosed">
    <Border x:Name="IslandBorder"
            Background="{DynamicResource IslandBackground}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="0,0,20,20"
            ClipToBounds="True"
            SnapsToDevicePixels="False"
            UseLayoutRounding="False">
        <Grid x:Name="ContentRoot" MouseLeftButtonUp="ContentRoot_OnMouseLeftButtonUp">
            <Border Height="1"
                    VerticalAlignment="Top"
                    Background="{DynamicResource GlassSheen}"
                    IsHitTestVisible="False" />

            <Border x:Name="HiddenTrigger"
                    Width="34"
                    Height="2"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource Accent}"
                    Opacity="0.42"
                    CornerRadius="1" />

            <Grid x:Name="CompactHost"
                  Visibility="Collapsed">
                <ui:CompactView x:Name="CompactContent" />
            </Grid>

            <Grid x:Name="ExpandedHost"
                  Visibility="Collapsed">
                <ui:ExpandedView x:Name="ExpandedContent" />
            </Grid>

            <Canvas x:Name="ClockTransitionOverlay"
                    Panel.ZIndex="10"
                    ClipToBounds="True"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="ClockTitleOverlay"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="10.5"
                           FontWeight="SemiBold">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="ClockTitleOverlayScale" />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="ClockTimeOverlay"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="13"
                           FontWeight="SemiBold">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="ClockTimeOverlayScale" />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="ClockDateOverlay"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="11"
                           FontWeight="SemiBold">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="ClockDateOverlayScale" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
        </Grid>
    </Border>
</Window>
