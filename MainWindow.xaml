<Window x:Class="NotchBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NotchBar.UI"
        Width="400"
        Height="38"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        MouseEnter="Window_OnMouseEnter"
        MouseLeave="Window_OnMouseLeave"
        SourceInitialized="Window_OnSourceInitialized"
        Closed="Window_OnClosed">
    <Border x:Name="IslandBorder"
            Background="{DynamicResource IslandBackground}"
            BorderBrush="{DynamicResource IslandBorder}"
            BorderThickness="1"
            CornerRadius="18"
            ClipToBounds="True">
        <Grid x:Name="ContentRoot" MouseLeftButtonUp="ContentRoot_OnMouseLeftButtonUp">
            <Border x:Name="HiddenTrigger"
                    Height="2"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource Accent}"
                    CornerRadius="1" />
            <ui:CompactView x:Name="CompactContent" Visibility="Collapsed" />
            <ui:ExpandedView x:Name="ExpandedContent" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
