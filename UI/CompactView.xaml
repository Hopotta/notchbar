<UserControl x:Class="NotchBar.UI.CompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="44"
             Background="Transparent">
    <Grid Margin="13,0,8,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="StatusHalo"
                Width="18"
                Height="18"
                CornerRadius="9"
                Background="{DynamicResource AccentSoft}"
                VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot"
                     Width="6"
                     Height="6"
                     Fill="{DynamicResource Accent}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <Border Grid.Column="1"
                Margin="8,0,0,0"
                Padding="7,3"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource InnerHairline}"
                BorderThickness="1"
                CornerRadius="7"
                VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       Foreground="{DynamicResource SecondaryText}"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <TextBlock x:Name="SummaryText"
                   Grid.Column="2"
                   Margin="10,0,10,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource PrimaryText}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock x:Name="SecondaryText"
                   Grid.Column="3"
                   MaxWidth="112"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedText}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis" />

        <Button x:Name="PinButton"
                Grid.Column="4"
                Width="30"
                Height="28"
                Margin="8,0,0,0"
                Padding="0"
                Click="PinButton_OnClick"
                ToolTip="Pin / unpin"
                Style="{StaticResource CompactButtonStyle}">
            <Path x:Name="PinGlyph"
                  Width="13"
                  Height="13"
                  Stretch="Uniform"
                  Fill="{DynamicResource SecondaryText}"
                  Data="M4,1 H12 L10.5,5.2 L13.5,8 V9.5 H8.8 V14.2 L8,16 L7.2,14.2 V9.5 H2.5 V8 L5.5,5.2 Z" />
        </Button>
    </Grid>
</UserControl>
