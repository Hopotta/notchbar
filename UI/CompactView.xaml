<UserControl x:Class="NotchBar.UI.CompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="38"
             Background="Transparent">
    <Grid Margin="16,0,10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Ellipse x:Name="StatusDot"
                 Width="8"
                 Height="8"
                 Margin="0,0,8,0"
                 Fill="{DynamicResource Accent}"
                 VerticalAlignment="Center" />
        <TextBlock x:Name="CompactText"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource PrimaryText}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <Button x:Name="PinButton"
                Grid.Column="2"
                Width="28"
                Height="26"
                Margin="8,0,0,0"
                Padding="0"
                Click="PinButton_OnClick"
                ToolTip="Pin / unpin"
                Style="{StaticResource CompactButtonStyle}">
            <TextBlock x:Name="PinGlyph" Text="◇" FontSize="16" />
        </Button>
    </Grid>
</UserControl>
