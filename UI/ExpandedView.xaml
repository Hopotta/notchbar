<UserControl x:Class="NotchBar.UI.ExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="224"
             Background="Transparent">
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="10" Height="10" Margin="0,4,10,0" Fill="{DynamicResource Accent}" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="PinButton"
                    Grid.Column="2"
                    Width="32"
                    Height="28"
                    Padding="0"
                    Click="PinButton_OnClick"
                    ToolTip="Pin / unpin"
                    Style="{StaticResource CompactButtonStyle}">
                <TextBlock x:Name="PinGlyph" Text="◇" FontSize="17" />
            </Button>
        </Grid>

        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="1"
                     Height="4"
                     Margin="0,16,0,0"
                     Minimum="0"
                     Maximum="1"
                     Foreground="{DynamicResource AccentBlue}"
                     Background="#263346"
                     Visibility="Collapsed" />

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="DetailText"
                       Foreground="{DynamicResource PrimaryText}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       MaxHeight="80" />
            <TextBlock x:Name="SecondaryText"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource SecondaryText}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="UpdatedText"
                   Grid.Row="3"
                   Foreground="{DynamicResource MutedText}"
                   FontSize="11" />
    </Grid>
</UserControl>
