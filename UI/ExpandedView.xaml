<UserControl x:Class="NotchBar.UI.ExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid x:Name="LayoutRoot" Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderContent"
              MouseLeftButtonUp="HeaderContent_OnMouseLeftButtonUp">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="StatusHalo"
                    Width="24"
                    Height="24"
                    CornerRadius="12"
                    Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource InnerHairline}"
                    BorderThickness="1"
                    VerticalAlignment="Top">
                <Ellipse x:Name="StatusDot"
                         Width="7"
                         Height="7"
                         Fill="{DynamicResource Accent}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="10,-1,12,0">
                <TextBlock x:Name="TitleText"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SummaryText"
                           MaxWidth="300"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button x:Name="PinButton"
                    Grid.Column="2"
                    Width="32"
                    Height="30"
                    Padding="0"
                    Click="PinButton_OnClick"
                    ToolTip="Pin / unpin"
                    Style="{StaticResource CompactButtonStyle}">
                <Path x:Name="PinGlyph"
                      Width="14"
                      Height="14"
                      Stretch="Uniform"
                      Fill="{DynamicResource SecondaryText}"
                      Data="M4,1 H12 L10.5,5.2 L13.5,8 V9.5 H8.8 V14.2 L8,16 L7.2,14.2 V9.5 H2.5 V8 L5.5,5.2 Z" />
            </Button>
        </Grid>

        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="1"
                     Margin="0,14,0,0"
                     Minimum="0"
                     Maximum="1"
                     Style="{StaticResource IslandProgressBarStyle}"
                     Visibility="Collapsed" />

        <Grid x:Name="BodyHost" Grid.Row="2">
            <StackPanel x:Name="SimpleBody"
                        Margin="34,12,0,0"
                        Visibility="Collapsed">
                <TextBlock x:Name="SimpleSecondaryText"
                           MaxWidth="320"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SimpleDetailText"
                           MaxWidth="320"
                           Margin="0,3,0,0"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="11.5"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border x:Name="DetailPanel"
                    Margin="0,14,0,0"
                    Padding="13,11"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="DetailText"
                               MaxWidth="480"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="13.5"
                               LineHeight="19"
                               TextWrapping="Wrap"
                               MaxHeight="78" />
                    <TextBlock x:Name="SecondaryText"
                               MaxWidth="480"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="11.5"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel x:Name="UpdatedPanel"
                    Grid.Row="3"
                    Margin="2,11,0,0"
                    Orientation="Horizontal">
            <Ellipse Width="4"
                     Height="4"
                     Margin="0,0,7,0"
                     Fill="{DynamicResource MutedText}"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="UpdatedText"
                       Foreground="{DynamicResource MutedText}"
                       FontSize="11" />
        </StackPanel>
    </Grid>
</UserControl>
