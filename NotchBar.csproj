<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseUwp>true</UseUwp>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NotchBar</AssemblyName>
    <RootNamespace>NotchBar</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NotchBar.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);NotchBar.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Win2D.uwp" Version="1.28.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\IslandBackdropMask.png"
                      LogicalName="NotchBar.Assets.IslandBackdropMask.png" />
  </ItemGroup>

</Project>
