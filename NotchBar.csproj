<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseUwp>true</UseUwp>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NotchBar</AssemblyName>
    <RootNamespace>NotchBar</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NotchBar.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);NotchBar.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Win2D.uwp" Version="1.28.3" />
    <PackageReference Include="Microsoft.VCRTForwarders.140" Version="1.1.0"
                      GeneratePathProperty="true"
                      ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgMicrosoft_VCRTForwarders_140)\runtimes\win-x64\native\release\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
